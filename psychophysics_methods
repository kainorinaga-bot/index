<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#ffffff" />
<title>心理物理測定法デモ</title>
<style>
  :root{--bg:#f5f6f8;--card:#fff;--text:#111827;--muted:#6b7280;--line:#e5e7eb;--accent:#111827;--good:#166534;--warn:#92400e}
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic UI","Yu Gothic",Meiryo,sans-serif;background:var(--bg);color:var(--text)}
  .app{max-width:760px;margin:0 auto;min-height:100svh;padding:18px 14px 40px}
  header{padding:8px 2px 14px}
  h1{font-size:22px;margin:0 0 5px}.sub{font-size:13px;color:var(--muted);line-height:1.6}
  .card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 4px 16px rgba(0,0,0,.035)}
  .mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  button{font:inherit;border:0;border-radius:14px;padding:14px 16px;background:var(--accent);color:#fff;font-weight:700;cursor:pointer;touch-action:manipulation}
  button.secondary{background:#fff;color:var(--text);border:1px solid var(--line)}
  button.ghost{background:#eef0f3;color:var(--text)}
  button:disabled{opacity:.45;cursor:not-allowed}
  .mode{min-height:92px;text-align:left}.mode b{display:block;font-size:16px;margin-bottom:4px}.mode span{font-size:12px;font-weight:500;opacity:.8}
  .stim-wrap{background:#fff;border:1px solid var(--line);border-radius:18px;height:46svh;min-height:300px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
  .stimulus{font-family:Arial,Helvetica,sans-serif;font-size:min(30vw,180px);font-weight:700;line-height:1;user-select:none;-webkit-user-select:none}
  .corner{position:absolute;top:10px;right:12px;font-size:12px;color:#9ca3af}
  .controls{display:grid;gap:10px;margin-top:12px}
  .two{grid-template-columns:1fr 1fr}.three{grid-template-columns:1fr 1fr 1fr}
  input[type=range]{width:100%;accent-color:#111827}
  .value{font-variant-numeric:tabular-nums;font-size:34px;font-weight:800;text-align:center;margin:6px 0}
  .hint{font-size:13px;color:var(--muted);line-height:1.7}
  .progress{height:8px;background:#eceff3;border-radius:999px;overflow:hidden;margin:10px 0}.bar{height:100%;background:#111827;width:0%}
  .pill{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:5px 9px;font-size:12px;color:var(--muted)}
  table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left}td:last-child,th:last-child{text-align:right}
  .notice{background:#fff7ed;border:1px solid #fed7aa;color:var(--warn);border-radius:14px;padding:12px;font-size:13px;line-height:1.7}
  .success{background:#f0fdf4;border:1px solid #bbf7d0;color:var(--good);border-radius:14px;padding:12px;font-size:13px;line-height:1.7}
  .hidden{display:none!important}
  .footer{font-size:11px;color:#9ca3af;text-align:center;margin-top:18px;line-height:1.6}
  .mini{font-size:12px;color:var(--muted)}
</style>
</head>
<body>
<div class="app">
  <header>
    <h1>心理物理測定法デモ</h1>
    <div class="sub">同じ「見える／見えない」を、測り方を変えて測定します。<br>研究用の校正測定ではなく、授業用デモです。</div>
  </header>

  <section id="home">
    <div class="notice"><b>開始前</b><br>画面の自動明るさ・True Tone等は可能ならOFFにし、明るさを固定してください。端末間の値そのものは比較しません。</div>
    <div class="card">
      <div class="mode-grid">
        <button class="mode" onclick="startAdjustment()"><b>① 調整法</b><span>自分で薄さを調整</span></button>
        <button class="mode" onclick="startLimits()"><b>② 極限法</b><span>濃→薄／薄→濃</span></button>
        <button class="mode" onclick="startConstants()"><b>③ 恒常法</b><span>ランダム提示で回答</span></button>
        <button class="mode" onclick="startStaircase()"><b>④ 上下法</b><span>回答に応じて自動調整</span></button>
      </div>
    </div>
    <div class="card">
      <b>結果比較</b>
      <p class="hint">それぞれの方法を終えると、ここに推定値が保存されます。</p>
      <table id="resultTable"></table>
      <div class="controls two">
        <button class="secondary" onclick="copyResults()">結果をコピー</button>
        <button class="ghost" onclick="resetAll()">全結果をリセット</button>
      </div>
    </div>
  </section>

  <section id="task" class="hidden">
    <div class="card">
      <div style="display:flex;justify-content:space-between;gap:8px;align-items:center">
        <div><span id="methodPill" class="pill"></span></div>
        <button class="secondary" style="padding:8px 12px" onclick="goHome()">終了</button>
      </div>
      <h2 id="taskTitle" style="font-size:19px;margin:12px 0 6px"></h2>
      <div id="taskInstruction" class="hint"></div>
      <div class="progress"><div class="bar" id="progressBar"></div></div>
      <div id="progressText" class="mini"></div>
    </div>

    <div class="stim-wrap">
      <div class="corner">刺激：E</div>
      <div id="stimulus" class="stimulus">E</div>
    </div>

    <div id="dynamicControls" class="card controls"></div>
  </section>

  <section id="done" class="hidden">
    <div class="card">
      <div class="success" id="doneMessage"></div>
      <div class="value" id="doneValue"></div>
      <div class="hint" id="doneExplanation"></div>
      <div class="controls two" style="margin-top:14px">
        <button onclick="goHome()">結果一覧へ</button>
        <button class="secondary" id="repeatBtn">もう一度</button>
      </div>
    </div>
  </section>

  <div class="footer">表示コントラストは白背景に対するRGB階調から計算した「名目値」です。端末間の絶対比較には使えません。</div>
</div>

<script>
const $ = id => document.getElementById(id);
const state = {
  results: JSON.parse(localStorage.getItem('psychoDemoResults') || '{}'),
  timer:null,
  currentMethod:null
};

function clamp(v,a,b){return Math.max(a,Math.min(b,v));}
function setContrast(pct){
  pct=clamp(pct,0,100);
  const v=Math.round(255*(1-pct/100));
  $('stimulus').style.color=`rgb(${v},${v},${v})`;
}
function show(section){['home','task','done'].forEach(x=>$(x).classList.toggle('hidden',x!==section));window.scrollTo(0,0)}
function clearTimer(){if(state.timer){clearInterval(state.timer);state.timer=null}}
function goHome(){clearTimer();renderResults();show('home')}
function setupTask(method,title,instruction,progress=''){
  clearTimer(); state.currentMethod=method; $('methodPill').textContent=method; $('taskTitle').textContent=title; $('taskInstruction').innerHTML=instruction; $('progressText').textContent=progress; $('progressBar').style.width='0%'; $('dynamicControls').innerHTML=''; show('task');
}
function progress(done,total,label=''){$('progressBar').style.width=`${100*done/total}%`;$('progressText').textContent=label || `${done} / ${total}`}
function saveResult(key,label,value,detail){state.results[key]={label,value,detail,date:new Date().toISOString()};localStorage.setItem('psychoDemoResults',JSON.stringify(state.results));renderResults()}
function finish(key,label,value,explanation,restart){clearTimer();saveResult(key,label,value,explanation);$('doneMessage').innerHTML=`<b>${label} 完了</b>`;$('doneValue').textContent=`${value.toFixed(1)} %`;$('doneExplanation').textContent=explanation;$('repeatBtn').onclick=restart;show('done')}

function renderResults(){
  const order=['adjustment','limits','constants','staircase'];
  let html='<tr><th>方法</th><th>名目コントラスト</th></tr>';
  order.forEach(k=>{const r=state.results[k];html+=`<tr><td>${r?r.label:['調整法','極限法','恒常法','上下法'][order.indexOf(k)]}</td><td>${r?Number(r.value).toFixed(1)+' %':'—'}</td></tr>`});
  $('resultTable').innerHTML=html;
}
function resetAll(){state.results={};localStorage.removeItem('psychoDemoResults');renderResults()}
async function copyResults(){
  const order=['adjustment','limits','constants','staircase'];
  const lines=['心理物理測定法デモ 結果',...order.map(k=>state.results[k]?`${state.results[k].label}: ${Number(state.results[k].value).toFixed(1)}%`:'')].filter(Boolean);
  try{await navigator.clipboard.writeText(lines.join('\n'));alert('結果をコピーしました');}catch(e){alert(lines.join('\n'))}
}

// 1) Adjustment method
function startAdjustment(){
  setupTask('調整法','自分で「ギリギリ見える」位置に合わせる','スライダーを動かして、Eが<b>ギリギリ見える</b>濃さにして確認ボタンを押してください。');
  let current=50;
  setContrast(current);
  $('dynamicControls').innerHTML=`
    <div class="value" id="adjVal">${current}%</div>
    <input type="range" id="adjSlider" min="0" max="10" step="0.1" value="${current}">
    <button onclick="finishAdjustment()">確定</button>
  `;
  const slider = $('adjSlider');
  slider.min = "0"; slider.max = "30"; slider.step = "0.1"; slider.value = current;
  slider.oninput = e => {
    current = parseFloat(e.target.value);
    $('adjVal').textContent = current.toFixed(1) + '%';
    setContrast(current);
  };
}
function finishAdjustment(){
  const val = parseFloat($('adjSlider').value);
  finish('adjustment','調整法',val,'あなたがギリギリ見えると判断したコントラストの閾値です。',startAdjustment);
}

// 2) Method of limits
let limitsState = {};
function startLimits(){
  setupTask('極限法','「見える」か「見えない」かを答える','刺激の濃さが徐々に変化します。見えたら「見える」、見えなくなったら「見えない」を押してください。');
  limitsState = { series: 0, desc: true, current: 15, thresholds: [] };
  nextLimitsTrial();
}
function nextLimitsTrial(){
  if(limitsState.series >= 4){
    const avg = limitsState.thresholds.reduce((a,b)=>a+b,0)/limitsState.thresholds.length;
    finish('limits','極限法',avg,'上昇系列と下降系列の交替により、慣れや期待の誤差を相殺して求めた閾値です。',startLimits);
    return;
  }
  if(limitsState.desc){
    limitsState.current = 15 - Math.random()*3;
  } else {
    limitsState.current = 0 + Math.random()*3;
  }
  limitsState.lastResponse = null;
  runLimitsStep();
}
function runLimitsStep(){
  setContrast(limitsState.current);
  progress(limitsState.series, 4, `系列 ${limitsState.series + 1} / 4`);
  $('dynamicControls').innerHTML = `
    <div class="hint" style="text-align:center">文字が見えますか？</div>
    <div class="controls two">
      <button onclick="respondLimits(true)">見える</button>
      <button class="secondary" onclick="respondLimits(false)">見えない</button>
    </div>
  `;
}
function respondLimits(visible){
